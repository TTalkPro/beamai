{application, beamai_llm, [
    {description, "Agent Framework LLM Layer - Multi-Provider Support"},
    {vsn, "1.0.0"},
    {registered, []},
    {applications, [
        kernel,
        stdlib,
        beamai_core
    ]},
    {env, [
        {default_provider, openai},
        {default_model, "gpt-4"},
        {default_timeout, 60000}
    ]},
    {modules, [
        %% Client
        beamai_chat_completion,
        beamai_embedding,
        beamai_rerank,
        beamai_llm_http_client,
        beamai_llm_helper,
        beamai_llm_retry,
        %% Behaviour
        beamai_llm_provider_behaviour,
        beamai_embedding_provider_behaviour,
        beamai_rerank_provider_behaviour,
        %% Providers - Chat
        beamai_llm_provider_openai,
        beamai_llm_provider_anthropic,
        beamai_llm_provider_deepseek,
        beamai_llm_provider_ollama,
        beamai_llm_provider_zhipu,
        beamai_llm_provider_dashscope,
        beamai_llm_provider_xai,
        beamai_llm_provider_moonshot,
        beamai_llm_provider_openrouter,
        beamai_llm_provider_siliconflow,
        beamai_llm_provider_common,
        %% Providers - Embedding
        beamai_embedding_common,
        beamai_embedding_provider_openai,
        beamai_embedding_provider_dashscope,
        beamai_embedding_provider_zhipu,
        beamai_embedding_provider_siliconflow,
        beamai_embedding_provider_ollama,
        beamai_embedding_provider_mock,
        %% Providers - Rerank
        beamai_rerank_common,
        beamai_rerank_provider_siliconflow,
        beamai_rerank_provider_dashscope,
        beamai_rerank_provider_jina,
        beamai_rerank_provider_cohere,
        beamai_rerank_provider_voyage,
        beamai_rerank_provider_mock,
        %% Note: beamai_llm_response 已移至 beamai_core
        %% Adapters
        beamai_llm_message_adapter,
        beamai_llm_tool_adapter,
        beamai_llm_response_parser,
        beamai_llm_media,
        beamai_llm_content
    ]},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
