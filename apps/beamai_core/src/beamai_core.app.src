{application, beamai_core, [
    {description, "BeamAI Core - Kernel 框架"},
    {vsn, "1.0.0"},
    {registered, [beamai_core_sup,
                  http_pool_short,
                  http_pool_stream,
                  http_pool_longpoll]},
    {mod, {beamai_core_app, []}},
    %% gun 是硬依赖：beamai_core_sup 无条件启动三个 beamai_http_pool
    %% （http_pool_short/stream/longpoll），它们直接调 gun:open。
    {applications, [kernel, stdlib, uuid, gun]},
    %% 不声明 beamai_llm 依赖：beamai_llm 的 applications 含 beamai_core，
    %% 反向声明会成环。core 里唯一的运行时反向调用是门面
    %% beamai:add_chat_model/3 → beamai_chat_model:create/2，由使用方保证
    %% beamai_llm 已加载（直接用 beamai_kernel:add_chat_model/2 则无此依赖）。
    %% 注：这里原本有一条 {optional_applications, [beamai_llm]}，但 OTP 要求
    %% optional_applications 必须是 applications 的子集，未列入时该声明无效，
    %% 故删除而非补进 applications（补进即成环）。
    {env, []},
    {modules, [
        %% OTP 应用
        beamai_core_app,
        beamai_core_sup,
        %% Facade 入口
        beamai,
        %% Kernel 核心
        beamai_kernel,
        beamai_message,
        beamai_tool,
        beamai_tool_behaviour,
        beamai_context,
        beamai_result,
        beamai_prompt,
        beamai_llm_response,
        %% Filter（洋葱式过滤器）
        beamai_filter,
        beamai_filter_chain,
        %% 行为接口
        beamai_chat_behaviour,
        beamai_http_behaviour,
        beamai_chat_memory,
        beamai_memory_provider,
        %% 会话记忆（Memory Filter 机制）
        beamai_chat_memory_ets,
        beamai_memory_provider_default,
        beamai_memory_filter,
        %% HTTP 客户端
        beamai_http,
        beamai_http_gun,
        beamai_http_pool,
        %% JSON-RPC
        beamai_jsonrpc,
        %% SSE
        beamai_sse,
        %% 工具
        beamai_id,
        beamai_utils
    ]},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
