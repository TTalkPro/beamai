{erl_opts, [
    debug_info,
    warnings,
    warn_unused_vars,
    warn_export_all,
    warn_shadow_vars,
    warn_obsolete_guard,
    warn_unused_import,
    warn_unused_function,
    warn_bif_clash,
    warn_export_vars,
    warn_untyped_record
]}.

%% Umbrella 项目配置 - 核心三职责：ChatClient 基座 + LLM providers + SimpleAgent
{project_app_dirs, [
    "apps/beamai_core",
    "apps/beamai_llm",
    "apps/beamai_agent"
]}.

%% OTP 27 起 stdlib 内置 json 模块，JSON 编解码不再需要 jsx。
%% 该模块是本项目的 OTP 版本下限依据。
{minimum_otp_vsn, "27"}.

{deps, [
    {gun, "2.1.0"}
]}.

{shell, [
    {apps, [beamai_core, beamai_llm, beamai_agent]}
]}.

{relx, [
    {release, {beamai_framework, "1.0.0"}, [
        beamai_core,
        beamai_llm,
        beamai_agent,
        sasl
    ]},
    {mode, dev},
    {include_erts, false},
    {extended_start_script, true}
]}.

{profiles, [
    {test, [
        {deps, [
            {meck, "0.9.2"}
        ]},
        {erl_opts, [debug_info]}
    ]}
]}.

{project_plugins, [rebar3_proper, rebar3_ex_doc]}.

%% BeamAI 是框架库：导出 API 主要供宿主调用，项目内部没有调用者是预期状态。
%% 因此 xref 不开启 exports_not_used；仍保留未定义调用/函数、未用局部函数和
%% deprecated 检查，防止真实代码路径问题被公共 API 噪音掩盖。
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{ex_doc, [
    {extras, [
        {"README.md", #{title => "Overview"}},
        {"doc/ARCHITECTURE.md", #{title => "Architecture"}},
        {"doc/AGENT_MODULES.md", #{title => "Agent Modules"}}
    ]},
    {main, "README.md"},
    {source_url, "https://github.com/TTalkPro/beamai"},
    {api_reference, true}
]}.

{dialyzer, [
    {plt_extra_apps, [gun, public_key]},
    {warnings, [
        error_handling,
        unmatched_returns,
        unknown
    ]}
]}.

{alias, [
    {check, [xref, dialyzer, eunit, ct]}
]}.
